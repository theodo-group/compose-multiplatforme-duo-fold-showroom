language = Objective-C
package = dev.showroom.fold.cinterop
compilerOpts = -fobjc-arc
headers = SHHingeObserverView.h SHVerticalBarObserverView.h
headerFilter = SHHingeObserverView.h SHVerticalBarObserverView.h
---
// The implementations live in their own files because the cinterop indexer rejects an
// @implementation in the definition file itself. Including them here compiles them into the
// interop library.
#include "SHHingeObserverView.m"
#include "SHVerticalBarObserverView.m"
